# The MCP server reads the project root .env automatically, so you usually don't
# need this file. Create mcp-server/.env only to override values just for the
# server (it is gitignored).

# Required (falls back to ../.env). Same Atlas string TradeNote uses.
# MONGO_URI=mongodb://...

# Optional: restrict analysis to one account (username or email from TradeNote).
# Leave unset to analyze all trades in the DB (fine for a single-user journal).
# TRADENOTE_USER=you@example.com

# Optional: IANA timezone for weekday / entry-hour breakdowns. Default UTC.
# TRADENOTE_TZ=Asia/Bangkok
