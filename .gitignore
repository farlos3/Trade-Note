.env
# Timestamped .env backups hold the same secrets as .env itself.
# Deliberately not `.env.*`, which would also cover the tracked .env.example.
.env.*.bak
vendor
node_modules
.DS_Store
dist
.vscode
logs
.idea/

# MT5 sync local secrets/state
mt5-sync/config.ini
mt5-sync/state.json
__pycache__/

# Caveman agent skills (installed per-machine via the upstream install.sh).
# Vendored copies of JuliusBrussee/caveman — the installer drops the same skill
# set once per agent flavour. skills-lock.json pins them, so they can always be
# reinstalled; keep them out of this repo's history.
.agents/
agent/
skills-lock.json

# Claude Code project dir: ignore the vendored skills, but keep shared config
# (settings.json, commands) trackable so it can be committed deliberately.
.claude/skills/

# Local parquet backup copies + Atlas migration dump
backup/data/
_atlasdump/

# Pre-restore safety dumps of the local database
backup/pre-restore/

# Sync log written by the scheduled agent
mt5-sync/logs/

# Backup log written by the scheduled agent
backup/logs/

# Live MT5 feed agent output (mt5-sync/mt5_live.py, started by start.sh)
mt5-sync/live-agent.log
mt5-sync/live-agent.log.err

# Runtime state of the live MT5 feed agent (see start.sh)
mt5-sync/.live-agent.pid
