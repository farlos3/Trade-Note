# Copy this file to .env and fill in real values. .env is gitignored.
# Used by docker-compose (local) and as a reference for Render env vars.

# MongoDB Atlas connection string (include the /tradenote database name).
# URL-encode any special characters in the password (e.g. "?" -> "%3F").
MONGO_URI=mongodb+srv://<user>:<password>@trade-note.3mvpypa.mongodb.net/tradenote

# TradeNote database name inside MongoDB.
TRADENOTE_DATABASE=tradenote

# Random string used as the application ID (no spaces).
APP_ID=changeme

# Random string used as the master key for root backend access (no spaces).
MASTER_KEY=changeme

# Port the app listens on (locally 8080; on Render use 10000).
TRADENOTE_PORT=8080
