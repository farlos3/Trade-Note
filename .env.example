# Copy this file to .env and fill in real values. .env is gitignored.
# Used by docker-compose (local) and as a reference for Render env vars.

# MongoDB Atlas connection string (include the /tradenote database name).
# URL-encode any special characters in the password (e.g. "?" -> "%3F").
MONGO_URI=mongodb+srv://<user>:<password>@trade-note.3mvpypa.mongodb.net/tradenote

# TradeNote database name inside MongoDB.
TRADENOTE_DATABASE=tradenote

# Random string used as the application ID (no spaces).
APP_ID=changeme

# Random string used as the master key for root backend access (no spaces).
MASTER_KEY=changeme

# Port the app listens on (locally 8080; on Render use 10000).
TRADENOTE_PORT=8080

# --- MongoDB Atlas Admin API (optional; used by scripts/update-atlas-ip.sh|.ps1) ---
# Lets start.ps1 whitelist your current public IP in Atlas automatically.
# Atlas -> Access Manager -> API Keys. Role needed: Project Network Access Manager.
# Also add 0.0.0.0/0 to the KEY's own API Access List (step 2 of the key wizard),
# otherwise the key is pinned to one IP and breaks when your public IP changes.
# ATLAS_PROJECT_ID is the 24-char hex Project ID from the project Settings page.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=

# --- Cloudflare R2 image storage (optional) ---
# When all of these are set, screenshots are uploaded to R2 and only the URL is
# stored in MongoDB. If left blank, screenshots are stored as base64 in MongoDB.
# Create an API token (Object Read & Write) in Cloudflare: R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read URL of the bucket (no trailing slash), e.g. the r2.dev dev URL.
R2_PUBLIC_URL=https://pub-32ac1fe180ae4b1291b7c45d71fbe368.r2.dev
# Optional: full S3 endpoint. If omitted it is derived from R2_ACCOUNT_ID.
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
